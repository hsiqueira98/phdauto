!.vscode/extensions.json
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.idea/
.idea_modules/
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/
*.iml
*.iws
*.ipr
.netbeans/

