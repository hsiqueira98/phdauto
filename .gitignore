# ============================================================
#  PHD Automóveis — Padrões de Exclusão
#  Princípio: versionar apenas código necessário para rodar
# ============================================================

# --- DEPENDÊNCIAS E BUILD (recriados por npm install / npm run build)
node_modules/
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo
out/

# --- VARIÁVEIS DE AMBIENTE E SEGREDOS (nunca versionar credenciais)
.env
.env.local
.env.*.local
.env.production
.env.development
!.env.example
*.pem
*.key
*.p12
*.pfx
*.pub
secrets.json
credentials.json
token.json
tokens.json
.auth/

# --- DOCUMENTOS DE TRABALHO INTERNO
.claude/
.prompts/
.instructions/
.notes/
PROMPT*.md
ANALISE*.md
.analysis/

# --- CACHE DE FERRAMENTAS E BUILDS
.cache/
.temp/
.tmp/
.eslintcache
.stylelintcache
.node_cache/
.bundle/
coverage/
.nyc_output/
.jest-cache/
.turbo/

# --- LOGS (NUNCA versionar logs com credenciais)
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
lerna-debug.log.json
debug.log
.npm/

